# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/.conversation/attached_assets/
/artifacts/agon-control/public/agent/
/artifacts/agon-control/public/downloads/agon-*.zip
/artifacts/agon-control/android-agent/.gradle/
/artifacts/agon-control/android-agent/build/
/artifacts/agon-control/android-agent/app/build/
/.cache/android-sdk/
